# ── GAS ERP Backend ──────────────────────────────────────────────────────────
# Web App URL del ERP (Google Apps Script, dominio bidcom.com.ar)
GAS_URL="https://script.google.com/a/macros/bidcom.com.ar/s/[DEPLOYMENT_ID]/exec"

# API Key generada con setupApiKey() en el proyecto GAS
GAS_API_KEY=""

# ── Base de datos (Neon PostgreSQL) ──────────────────────────────────────────
# Obtener de: https://console.neon.tech → tu proyecto → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Anthropic (IA para leer etiquetas) ───────────────────────────────────────
# Obtener de: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Google Sheets / Drive (opcional) ─────────────────────────────────────────
# Crear cuenta de servicio en Google Cloud Console > IAM > Service Accounts
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# URL del Google Sheet GSO V4 (planilla con SOs, modelos, fobs).
# Optional — si está vacío usa el default del código. Si Comex cambia
# la sheet, actualizá esto en Vercel sin tener que tocar código.
GSO_SHEET_CSV_URL=""

# ── NextAuth v5 (Auth.js) ────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# ── Resend (magic links del login) ───────────────────────────────────────────
# 1. Signup gratis en https://resend.com (3000 mails/mes free)
# 2. Crear API key en https://resend.com/api-keys (scope "Full access")
# 3. Pegarla acá. En Vercel: agregar en Settings → Environment Variables
AUTH_RESEND_KEY="re_..."

# Email "from" que aparece en los magic links. Mientras el dominio bidcom.com.ar
# no esté verificado en Resend (requiere acceso DNS), dejar el default — Resend
# permite usar onboarding@resend.dev sin verificación. Una vez verificado el
# dominio, cambiar a: Bidcom Agro <no-reply@bidcom.com.ar>
AUTH_EMAIL_FROM="Bidcom Agro <onboarding@resend.dev>"

# Necesario en producción detrás de proxy (Vercel). En local podés omitirlo.
AUTH_TRUST_HOST="true"
