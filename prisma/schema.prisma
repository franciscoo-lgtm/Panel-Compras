// ─── Generator & Datasource ───────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  role          String     @default("comercial") // "comercial" | "comex" | "admin"
  createdAt     DateTime   @default(now())
  accounts      Account[]
  sessions      Session[]
  ciplItems     CIPLItem[]
  compras       Compra[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Dominio principal ────────────────────────────────────────────────────────

model CIPLItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Identidad ───────────────────────────────────────────────────────────────
  userId       String?
  user         User?   @relation(fields: [userId], references: [id])
  categoryName String?  // nombre del operador (pre-auth)
  tipoCarga    String   // "Repuesto" | "Mercaderia"

  // ── Extraídos por ETL ───────────────────────────────────────────────────────
  sortOrder       Int?      // row position within the original PL (0-based)
  asn             String?
  date            DateTime?
  piNo            String?
  caseNo          String?
  qBultos         Int?
  qty             Int?
  codeEan         String?
  description     String?
  w               Float?    // cm — ancho caja
  l               Float?    // cm — largo caja
  h               Float?    // cm — alto caja
  cbm             Float?    // m³ total del grupo de bultos
  gwKg            Float?    // kg bruto
  cbmXBulto       Float?    // m³ por bulto
  uniXBulto       Float?    // unidades por bulto
  isDangerousGood Boolean   @default(false)

  // ── Asignados por el usuario ────────────────────────────────────────────────
  soPrincipal  String?
  soSecundario String?
  linkMsds     String?

  // ── Links Google Drive ──────────────────────────────────────────────────────
  driveLinkExcel String?
  driveLinkCi    String?
  driveLinkPl    String?

  // ── GSO V4 — guardados al asignar SO ────────────────────────────────────────
  sku            String?
  pa             String?
  modelo         String?
  qPi            Int?
  diferenciaPiPl Int?

  // ── Control (Fase 2) ───────────────────────────────────────────────────────
  controlReviewed   Boolean   @default(false)
  controlReviewedAt DateTime?
  controlReviewedBy String?
  controlNota       String?
  controlManualQty  Int?

  // ── Fotos inspección ────────────────────────────────────────────────────────
  photos     CIPLPhoto[]

  // ── Orden de Compra ─────────────────────────────────────────────────────────
  compraId  String?
  compra    Compra?  @relation(fields: [compraId], references: [id])

  // Índices: las queries más frecuentes filtran/agrupan por estos campos.
  // Sin estos, el panel hace table scan en cada page load.
  @@index([soPrincipal])  // listEmbarques, search, suggest-sos historical
  @@index([asn])          // search, /comercial flow, fuzzy matching
  @@index([compraId])     // detail de compras, dashboard
  @@index([createdAt])    // dashboard "últimos N días"
}

// ─── Órdenes de Compra ────────────────────────────────────────────────────────

model Compra {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  piNo  String?
  notas String?

  supplierName         String?
  supplierAddress      String?
  supplierContactName  String?
  supplierContactPhone String?
  supplierContactEmail String?

  fechaOrden          DateTime  @default(now())
  fechaEnvio          DateTime?
  fechaPago           DateTime?
  fechaSegundaValPA   DateTime?
  fechaInstruccionCat DateTime?
  fechaLMS            DateTime?

  sos       CompraSOItem[]
  ciplItems CIPLItem[]
}

model CompraSOItem {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  soNumber String

  modelo   String?
  sku      String?
  qPi      Int?
  fobUnit  Float?
  fobTotal Float?
  incoterm String?
  pa       String?

  @@index([soNumber])
}

// ─── Fotos de inspección ─────────────────────────────────────────────────────
// Nuevas fotos: se suben a Google Drive y solo se guarda el link.
// Campo legacy `dataUrl` (base64 inline) mantenido como nullable por compat
// retro con código que aún lo refiere — se va a borrar una vez sin call sites.

model CIPLPhoto {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  ciplItemId String
  ciplItem   CIPLItem @relation(fields: [ciplItemId], references: [id], onDelete: Cascade)
  driveLink  String?  // URL pública del archivo en Drive (nuevo formato)
  dataUrl    String?  // base64 inline (legacy — deprecated)
  rowIndex   Int      // fila en el Excel (= caja física)
  colIndex   Int      // posición dentro de la fila
}

// ─── Configuración del sistema ────────────────────────────────────────────────

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique // ej: "GSO_V4_URL", "NEXTAUTH_ALLOWED_EMAILS"
  value String
}
